# ---------- Sunucu ----------
# SQLite dosyasi Prisma semasinin yaninda durur. Goreli yollar prisma/ icinden cozulur.
DATABASE_URL="file:./dev.db"

# Merkezi sunucunun HTTP + WebSocket portu
PORT=3001

# Tum ikili icerigin (dosyalar, ekran goruntuleri) kok klasoru. SQLite yalnizca
# bu klasore goreli yollari tutar. Uretimde tam yol vermek onerilir.
STORAGE_ROOT="./storage"

# Tarayicidan API cagirmasina izin verilen adresler (virgulle ayrilir).
# Uretimde arayuz ayni portta yayinlandigi icin kullanilmaz; gelistirmede gerekir.
WEB_ORIGIN="http://localhost:5173"

# Sunucunun kabul ettigi en dusuk agent surumu. Eskiler guncelleme mesaji alir.
MIN_AGENT_VERSION="0.1.0"

# ---------- Agent (yalnizca analist makinesinde gerekir) ----------
# Normalde web arayuzunden indirilen testkit-agent.config.json dosyasindan okunur.
# Bu degiskenler tanimliysa dosyanin yerine gecer.
# TESTKIT_SERVER_URL="http://localhost:3001"
# TESTKIT_AGENT_TOKEN="dev-token"
# TESTKIT_AGENT_NAME="AHMET-PC"
